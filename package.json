{
  "name": "mindquest-quiz-competition",
  "version": "1.0.0",
  "description": "Fast, reliable online competition quiz web app with server-side scoring, PDF question bank parsing, anti-cheat, and real-time leaderboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "generate-sample": "node scripts/generate-sample-pdf.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.14"
  }
}
